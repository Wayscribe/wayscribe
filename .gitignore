# Local agent state, including git worktrees that other branches are checked out
# into. Nothing here belongs in the repository, and tools that walk the tree
# (Prettier, ESLint) must not reach into another branch's working files.
/.claude/

# SBOMs written by scripts/sbom.sh and scripts/attest-and-sign.sh.
/sboms/

# Python SDK build and interpreter caches.
/packages/sdk-python/**/__pycache__/
/packages/sdk-python/**/*.pyc
/packages/sdk-python/build/
/packages/sdk-python/*.egg-info/
/packages/sdk-python/src/*.egg-info/
/packages/sdk-python/.venv/

# Maven output of the Java OTLP example.
/examples/otlp-java/target/
