{
	# The rate-limit module's directive has no default order.
	order rate_limit before reverse_proxy
}

# demo.wayscribe.dev on the VM, with a certificate Caddy obtains itself (the
# Cloudflare record is DNS only). ":80" in CI, plain HTTP.
{$DEMO_SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		# One year, for this host only (no includeSubDomains).
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Search engines stay out. The link-preview fetchers are let in: they honour
	# robots.txt, so without this a shared demo link unfurls with no card. They
	# read the page's Open Graph tags and image, and the noindex header above
	# still keeps the page out of any index.
	handle /robots.txt {
		respond <<ROBOTS
			User-agent: LinkedInBot
			User-agent: facebookexternalhit
			User-agent: Twitterbot
			User-agent: Slackbot
			User-agent: Discordbot
			Allow: /

			User-agent: *
			Disallow: /
			ROBOTS 200
	}

	# Per client address. 300 a minute: a journey page polls every two seconds
	# and a page load fetches about twenty assets. Hashed static assets are
	# immutable and not counted.
	@limited not path /_next/static/*
	rate_limit @limited {
		zone per_client {
			key {remote_host}
			events 300
			window 1m
		}
	}

	reverse_proxy web:3000

	# Error responses (a 429 from the limiter, a 502 while web restarts) skip the
	# header block above, so repeat it.
	handle_errors {
		header {
			X-Robots-Tag "noindex, nofollow"
			Strict-Transport-Security "max-age=31536000"
			-Server
		}
	}

	# Read by the visit notifier and by Jorge. Kept 7 days. 0644 inside a
	# directory only root can reach on the host (docs/DEMO_HOSTING.md).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 14
			roll_keep_for 168h
			mode 0644
		}
		format json
	}
}
