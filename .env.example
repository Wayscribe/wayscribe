# Server
DATABASE_URL=postgresql://flight:flight@localhost:5432/flight
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
PORT=8080
LOG_LEVEL=info

# Security — replace both before any non-local use.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-for-local-development-0000
ADMIN_TOKEN=replace-for-local-development-0000
# Only while rotating ENCRYPTION_KEY: the key being replaced, so data written
# under it stays readable until it is re-encrypted. Leave unset otherwise.
# ENCRYPTION_KEY_PREVIOUS=

# Capture and retention
DEFAULT_RETENTION_DAYS=7
MAX_EVENT_PAYLOAD_BYTES=262144
ALLOW_FULL_PAYLOAD_CAPTURE=false

# Reverse proxies in front of the API and the web app that append to
# X-Forwarded-For. 0 keys the authentication throttles on the socket address
# and ignores the header, which any client can set (docs/OPERATIONS.md §9).
# TRUSTED_PROXY_COUNT=0

# Replay
REPLAY_ALLOWED_HOSTS=localhost,host.docker.internal,demo-integration

# Operability (docs/OPERATIONS.md §13)
# Every database statement the API runs is cancelled after this many
# milliseconds and answered 503 query_timeout. Default 15000; 0 disables it.
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Unset means no metrics listener. When set, the API serves Prometheus metrics
# at /metrics on this port only, never on PORT. Compose does not publish it.
# METRICS_PORT=9464
