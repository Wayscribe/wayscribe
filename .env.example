# Server
DATABASE_URL=postgresql://wayscribe:wayscribe@localhost:5432/wayscribe
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
# The API's listening port when run from source (default 8080). The Compose
# stacks set their own and ignore this; move the host port with API_PORT.
# PORT=8080
LOG_LEVEL=info

# Security — replace both before any non-local use.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-for-local-development-0000
ADMIN_TOKEN=replace-for-local-development-0000
# Only while rotating ENCRYPTION_KEY: the key being replaced, so data written
# under it stays readable until it is re-encrypted. Leave unset otherwise.
# ENCRYPTION_KEY_PREVIOUS=
# Each of the three above may be read from a file instead, which keeps it out of
# the container's environment and so out of `docker inspect`
# (docs/OPERATIONS.md §6; infrastructure/compose.secret-files.yaml wires this up
# for a Compose stack). Setting both a value and its file is refused at startup,
# and so is an empty file. Unset the _FILE setting to end a rotation; emptying
# the file it names does not.
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
# ENCRYPTION_KEY_PREVIOUS_FILE=/run/secrets/encryption_key_previous
# ADMIN_TOKEN_FILE=/run/secrets/admin_token

# The key `doctor` checks with, when it is not given as --api-key. The
# environment keeps it out of the process list (docs/OPERATIONS.md §12).
# WAYSCRIBE_API_KEY=

# Capture and retention
DEFAULT_RETENTION_DAYS=7
MAX_EVENT_PAYLOAD_BYTES=262144
ALLOW_FULL_PAYLOAD_CAPTURE=false

# Reverse proxies in front of the API and the web app that append to
# X-Forwarded-For. 0 keys the authentication throttles on the socket address
# and ignores the header, which any client can set (docs/OPERATIONS.md §9).
# TRUSTED_PROXY_COUNT=0

# Replay
REPLAY_ALLOWED_HOSTS=localhost,host.docker.internal,demo-integration

# Operability (docs/OPERATIONS.md §13)
# Every database statement the API runs is cancelled after this many
# milliseconds and answered 503 query_timeout. Default 15000; 0 disables it.
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Unset means no metrics listener. When set, the API serves Prometheus metrics
# at /metrics on this port only, never on PORT. Compose does not publish it.
# METRICS_PORT=9464
