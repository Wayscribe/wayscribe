# CI caches the pnpm content-addressed store inside the project directory,
# because GitLab can only cache paths under it.
.pnpm-store/

# Authored prose, not generated code. Prettier reformats markdown tables and
# rewrites code samples inside fenced blocks, which would churn the planning
# documents and make the implementation plan's code diverge from what was
# actually written. Documentation formatting is reviewed by humans.
docs/
*.md

# Helm templates are YAML with Go templating interleaved, which no YAML parser
# accepts. `helm lint` and `helm template` are what check these; the chart's
# plain values.yaml and Chart.yaml are still formatted.
deploy/helm/*/templates/

# The generator owns this formatting. Prettier reflows a JSON array that fits
# on one line, so `pnpm format` and `pnpm --filter @flight-recorder/protocol run
# schemas` would rewrite each other forever, and the drift test would fail after
# whichever ran second.
packages/protocol/schemas/

# Local agent state and worktrees of other branches (see .gitignore).
.claude/
