{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Journey event",
  "description": "One recorded step in a journey: which entity it concerned, which service handled it, what happened, and when. Limits this schema cannot express, such as the serialized size of the whole envelope and the depth and key counts of a payload, are in the ingestion contract.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "journeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entity": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "received",
        "identified",
        "transformed",
        "validated",
        "persisted",
        "published",
        "consumed",
        "delivered",
        "failed",
        "retried",
        "completed"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      }
    },
    "displayableAliases": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "description": "Alias types from this event's aliases that a reader may see in full. Every other alias is masked when read. An alias is shown in full only while every event that stated it listed it here; a type this event's aliases do not name is ignored."
    },
    "journeyLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Public display text for this event's journey, 1 to 200 characters. It is shown and searchable in full, so it must not hold personal data. An event without it leaves the journey's label unchanged."
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "parentEventId": {
      "type": "string",
      "maxLength": 128
    },
    "traceId": {
      "type": "string",
      "maxLength": 128
    },
    "spanId": {
      "type": "string",
      "maxLength": 128
    },
    "messageId": {
      "type": "string",
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "maxLength": 256
    },
    "input": {},
    "output": {},
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "code": {
          "type": "string",
          "maxLength": 256
        },
        "stack": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "message"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "hostname": {
          "type": "string",
          "maxLength": 256
        },
        "processId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sdk": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "name",
            "version"
          ]
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "gitCommit": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "image": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 128
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "journeyId",
    "environment",
    "service",
    "entity",
    "operation",
    "name",
    "timestamp"
  ]
}
