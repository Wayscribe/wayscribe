{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-accepted.schema.json",
  "title": "Single-event ingestion response",
  "description": "The body of an accepted single-event ingestion request.",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "journeyId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "accepted"
        },
        "duplicate": {
          "type": "boolean",
          "description": "True when an event with this id and identical content was already stored."
        }
      },
      "required": [
        "eventId",
        "journeyId",
        "status",
        "duplicate"
      ]
    }
  },
  "required": [
    "data"
  ]
}
