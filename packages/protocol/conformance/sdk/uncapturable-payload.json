{
  "id": "sdk/uncapturable-payload",
  "title": "A payload the recorder cannot read becomes a marker, and the event is still sent",
  "source": "ADR-034; packages/sdk-node/README.md value table",
  "layer": "sdk",
  "languages": ["node"],
  "calls": [
    {
      "call": "record",
      "args": {
        "operation": "received",
        "name": "receive-order",
        "input": {
          "ok": "yes",
          "broken": {
            "$throwingGetter": "no reading this"
          }
        }
      }
    }
  ],
  "expect": {
    "wire": {
      "input": "[UNCAPTURABLE]"
    },
    "results": [
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "inputPayload": "[UNCAPTURABLE]"
          }
        }
      }
    ]
  }
}
