{
  "id": "sdk/unredacted-secret-name",
  "title": "A secret-looking name no rule covers is reported, once per name, and the event is sent unchanged",
  "source": "docs/SDK_SPEC.md SDK-61; ADR-055",
  "layer": "sdk",
  "languages": ["*"],
  "calls": [
    {
      "call": "record",
      "repeat": 2,
      "args": {
        "operation": "received",
        "name": "receive-webhook",
        "input": {
          "sessionCredential": "cfx-fake-sdk-SESSION",
          "password": "cfx-fake-sdk-hunter2",
          "lines": [
            {
              "settings": {
                "authToken": "cfx-fake-sdk-AUTH"
              }
            }
          ],
          "tokenCount": 3
        }
      }
    }
  ],
  "expect": {
    "wire": {
      "input": {
        "sessionCredential": "cfx-fake-sdk-SESSION",
        "password": "[REDACTED]",
        "lines": [
          {
            "settings": {
              "authToken": "cfx-fake-sdk-AUTH"
            }
          }
        ],
        "tokenCount": 3
      }
    },
    "diagnostics": [
      {
        "kind": "unredacted_secret_name",
        "detail": {
          "field": "input",
          "name": "sessionCredential",
          "path": "input.sessionCredential"
        }
      },
      {
        "kind": "unredacted_secret_name",
        "detail": {
          "field": "input",
          "name": "authToken",
          "path": "input.lines[*].settings.authToken"
        }
      }
    ],
    "results": [
      {
        "status": "accepted",
        "duplicate": false
      },
      {
        "status": "accepted",
        "duplicate": false
      }
