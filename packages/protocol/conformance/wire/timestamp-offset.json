{
  "id": "wire/timestamp-offset",
  "title": "An offset timestamp is stored as the same instant in UTC, truncated to milliseconds",
  "source": "packages/protocol/src/event.ts; docs/EVENT_PROTOCOL.md",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_offset",
          "journeyId": "jrn_{{run}}_offset",
          "environment": "conformance",
          "service": "customer-integration",
          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "received",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.120+02:00"
        }
      },
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_fraction",
          "journeyId": "jrn_{{run}}_fraction",
          "environment": "conformance",
          "service": "customer-integration",
          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "received",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.1239999Z"
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "eventTimestamp": "2026-08-06T16:31:02.120Z"
          }
        }
      },
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "eventTimestamp": "2026-08-06T18:31:02.123Z"
          }
        }
      }
    ]
  }
}
