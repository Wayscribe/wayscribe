{
  "id": "wire/header-name-value-objects",
  "title": "{name,value} and {key,value} elements have their value redacted",
  "source": "docs/SECURITY.md section 4",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "customer-integration",
          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "received",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.000Z",
          "input": {
            "named": [
              {
                "name": "Authorization",
                "value": "Bearer cfx-fake-NAMED"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "keyed": [
              {
                "key": "cookie",
                "value": "session=cfx-fake-KEYED"
              }
            ],
            "extra": [
              {
                "name": "authorization",
                "value": "kept",
                "comment": "three keys"
              }
            ]
          }
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "inputPayload": {
              "named": [
                {
                  "name": "Authorization",
                  "value": "[REDACTED]"
                },
                {
                  "name": "Accept",
                  "value": "application/json"
                }
              ],
              "keyed": [
                {
                  "key": "cookie",
                  "value": "[REDACTED]"
                }
              ],
              "extra": [
                {
                  "name": "authorization",
                  "value": "kept",
                  "comment": "three keys"
                }
              ]
            }
          }
        }
      }
    ]
  }
}
