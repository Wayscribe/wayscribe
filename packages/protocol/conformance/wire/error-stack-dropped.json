          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "failed",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.000Z",
          "error": {
            "type": "HttpError",
            "message": "Unprocessable Entity",
            "stack": "HttpError: Unprocessable Entity\n    at deliver (/srv/app/deliver.js:42:11)"
          }
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "error": {
              "type": "HttpError",
              "message": "Unprocessable Entity",
