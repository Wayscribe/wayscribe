  "source": "ADR-046",
  "layer": "wire",
  "languages": ["*"],
  "setup": {
    "environment": {
      "captureMode": "redacted-payload"
    }
  },
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
