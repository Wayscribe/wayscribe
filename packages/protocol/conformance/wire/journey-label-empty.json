{
  "id": "wire/journey-label-empty",
  "title": "An empty journey label refuses that event alone, and the detail names the field",
  "source": "docs/EVENT_PROTOCOL.md section 3; docs/superpowers/specs/2026-09-16-journeys-browse-design.md section 1",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_empty",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "job-sweep",
          "entity": {
            "type": "job_posting",
            "id": "greenhouse:4567"
          },
          "operation": "received",
          "name": "sweep-board",
          "timestamp": "2026-09-16T08:00:00.000Z",
          "journeyLabel": ""
        }
      },
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_unlabelled",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "job-sweep",
          "entity": {
            "type": "job_posting",
            "id": "greenhouse:4567"
          },
          "operation": "received",
          "name": "sweep-board",
          "timestamp": "2026-09-16T08:00:00.000Z"
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "rejected",
        "error": {
          "code": "invalid_event",
          "httpStatus": 400,
          "details": [
            {
              "path": "event.journeyLabel"
            }
          ]
        }
      },
      {
        "status": "accepted",
        "duplicate": false
      }
    ]
  }
}
