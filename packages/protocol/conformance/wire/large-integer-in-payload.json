{
  "id": "wire/large-integer-in-payload",
  "title": "An integer beyond 2^53 is stored as the double the parser produced",
  "source": "docs/INGESTION_CONTRACT.md; ADR-049",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "customer-integration",
          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "received",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.000Z",
          "input": {
            "accountNumber": 9007199254740992
          }
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "event": {
            "inputPayload": {
              "accountNumber": 9007199254740992
            }
          }
        }
      }
    ]
  }
}
