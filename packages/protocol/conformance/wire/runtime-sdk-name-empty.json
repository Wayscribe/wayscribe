{
  "id": "wire/runtime-sdk-name-empty",
  "title": "An sdk inside runtime without a usable name is invalid_event, naming event.runtime.sdk.name",
  "source": "ADR-063; docs/EVENT_PROTOCOL.md section 3",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "customer-integration",
          "entity": {
            "type": "customer",
            "id": "0018Z00002ABC"
          },
          "operation": "received",
          "name": "receive-salesforce-webhook",
          "timestamp": "2026-08-06T18:31:02.000Z",
          "runtime": {
            "language": "node",
            "sdk": {
              "name": "",
              "version": "0.1.0"
            }
          }
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "rejected",
        "error": {
          "code": "invalid_event",
          "httpStatus": 400,
          "details": [
            {
              "path": "event.runtime.sdk.name"
            }
          ]
        }
      }
    ]
  }
}
