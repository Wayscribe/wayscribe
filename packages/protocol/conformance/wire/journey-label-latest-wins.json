{
  "id": "wire/journey-label-latest-wins",
  "title": "The label and the last step follow the latest timestamp, not the order events arrive in",
  "source": "docs/EVENT_PROTOCOL.md section 3; docs/INGESTION_CONTRACT.md section 7",
  "layer": "wire",
  "languages": ["*"],
  "send": {
    "events": [
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_newer",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "job-sweep",
          "entity": {
            "type": "job_posting",
            "id": "greenhouse:4567"
          },
          "operation": "identified",
          "name": "identify",
          "timestamp": "2026-09-16T08:01:00.000Z",
          "journeyLabel": "Newer label"
        }
      },
      {
        "protocolVersion": "0.1",
        "event": {
          "id": "evt_{{run}}_older",
          "journeyId": "jrn_{{run}}",
          "environment": "conformance",
          "service": "job-sweep",
          "entity": {
            "type": "job_posting",
            "id": "greenhouse:4567"
          },
          "operation": "received",
          "name": "sweep-board",
          "timestamp": "2026-09-16T08:00:00.000Z",
          "journeyLabel": "Older label"
        }
      }
    ]
  },
  "expect": {
    "results": [
      {
        "status": "accepted",
        "duplicate": false
      },
      {
        "status": "accepted",
        "duplicate": false,
        "stored": {
          "journey": {
            "label": "Newer label",
            "lastStep": "identify"
          }
        }
      }
    ]
  }
}
