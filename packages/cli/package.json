  "description": "Read journeys, timelines and payload diffs from a Flight Recorder installation.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "flight-recorder": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
