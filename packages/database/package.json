{
  "name": "@wayscribe/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/postgres.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts migrate",
    "migrate:unlock": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts migrate:unlock",
    "rollback": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts rollback",
    "reset": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts reset",
    "seed": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts seed",
    "seed-demo": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts seed-demo",
    "project:create": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts project:create",
    "project:list": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts project:list",
    "key:create": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts key:create",
    "key:revoke": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts key:revoke",
    "key:list": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts key:list",
    "retention:sweep": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts retention:sweep",
    "rotate:reencrypt": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts rotate:reencrypt",
    "rotate:status": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts rotate:status",
    "delete:journey": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts delete:journey",
    "delete:identifier": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts delete:identifier",
    "delete:range": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts delete:range",
    "delete:destination": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts delete:destination",
    "doctor": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts doctor",
    "backup:create": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts backup:create",
    "backup:restore": "tsx --conditions=development --env-file-if-exists=../../.env src/cli.ts backup:restore"
  },
  "dependencies": {
    "@wayscribe/config": "workspace:*",
    "@wayscribe/payload-security": "workspace:*",
    "knex": "^3.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
