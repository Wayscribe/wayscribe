{
  "name": "@flight-recorder/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "rollback": "tsx --env-file-if-exists=../../.env src/cli.ts rollback",
    "seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "seed-demo": "tsx --env-file-if-exists=../../.env src/cli.ts seed-demo",
    "project:create": "tsx --env-file-if-exists=../../.env src/cli.ts project:create",
    "project:list": "tsx --env-file-if-exists=../../.env src/cli.ts project:list",
    "key:create": "tsx --env-file-if-exists=../../.env src/cli.ts key:create",
    "key:revoke": "tsx --env-file-if-exists=../../.env src/cli.ts key:revoke",
    "key:list": "tsx --env-file-if-exists=../../.env src/cli.ts key:list",
    "retention:sweep": "tsx --env-file-if-exists=../../.env src/cli.ts retention:sweep"
  },
  "dependencies": {
    "@flight-recorder/payload-security": "workspace:*",
    "knex": "^3.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13"
  }
}
