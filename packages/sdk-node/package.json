{
  "name": "@flight-recorder/node",
  "version": "0.1.0",
  "description": "Record what happened to one customer record as it crossed your services, and see where a value changed.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/jojithedev/flight-recorder.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://gitlab.com/jojithedev/flight-recorder#readme",
  "bugs": {
    "url": "https://gitlab.com/jojithedev/flight-recorder/-/issues"
  },
  "keywords": [
    "debugging",
    "observability",
    "distributed-tracing",
    "integration",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@flight-recorder/payload-security": "workspace:*",
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
