{
  "name": "@wayscribe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@wayscribe/config": "workspace:*",
    "@wayscribe/database": "workspace:*",
    "@wayscribe/payload-diff": "workspace:*",
