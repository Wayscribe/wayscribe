{
  "name": "@flight-recorder/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@flight-recorder/config": "workspace:*",
    "@flight-recorder/database": "workspace:*",
    "@flight-recorder/payload-diff": "workspace:*",
    "@flight-recorder/payload-security": "workspace:*",
    "@flight-recorder/protocol": "workspace:*",
    "fastify": "^5",
    "knex": "^3",
    "pg": "^8",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "tsx": "^4"
  }
}
