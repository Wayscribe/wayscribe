    "@wayscribe/protocol": "workspace:*",
    "fastify": "^5.12.4",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "protobufjs": "7.6.6",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@wayscribe/node": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.13"
