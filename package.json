{
  "name": "wayscribe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "pnpm --filter @wayscribe/database run migrate",
    "db:migrate:unlock": "pnpm --filter @wayscribe/database run \"migrate:unlock\"",
    "db:rollback": "pnpm --filter @wayscribe/database run rollback",
    "db:reset": "pnpm --filter @wayscribe/database run reset --",
    "db:seed": "pnpm --filter @wayscribe/database run seed",
    "db:seed-demo": "pnpm --filter @wayscribe/database run seed-demo",
    "test:e2e": "playwright test",
    "test:demo": "vitest run --config vitest.demo.config.ts",
    "demo:trigger": "node scripts/demo-trigger.mjs",
    "project:create": "pnpm --filter @wayscribe/database run \"project:create\" --",
    "project:list": "pnpm --filter @wayscribe/database run \"project:list\" --",
    "cli": "pnpm --filter @wayscribe/cli exec node dist/cli.js",
    "screenshots": "node scripts/screenshots.mjs",
    "brand": "node scripts/render-brand.mjs",
    "key:create": "pnpm --filter @wayscribe/database run \"key:create\" --",
    "key:revoke": "pnpm --filter @wayscribe/database run \"key:revoke\" --",
    "key:list": "pnpm --filter @wayscribe/database run \"key:list\" --",
    "retention:sweep": "pnpm --filter @wayscribe/database run \"retention:sweep\" --",
    "rotate:reencrypt": "pnpm --filter @wayscribe/database run \"rotate:reencrypt\" --",
    "rotate:status": "pnpm --filter @wayscribe/database run \"rotate:status\" --",
    "delete:journey": "pnpm --filter @wayscribe/database run \"delete:journey\" --",
    "delete:identifier": "pnpm --filter @wayscribe/database run \"delete:identifier\" --",
    "delete:range": "pnpm --filter @wayscribe/database run \"delete:range\" --",
    "delete:destination": "pnpm --filter @wayscribe/database run \"delete:destination\" --",
    "doctor": "pnpm --filter @wayscribe/database run doctor --"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
