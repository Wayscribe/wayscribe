---
// Starlight's social icons, with a plain link to the documentation before them,
// so the landing page (which has no sidebar) has a way into the docs from the
// header.
import Default from "@astrojs/starlight/components/SocialIcons.astro";
---

<a class="docs-link" href="/docs/quick-start/">Docs</a>
<Default />

<style>
  .docs-link {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    margin-inline-end: 0.5rem;
  }
  .docs-link:hover {
    color: var(--sl-color-text-accent);
  }
</style>
