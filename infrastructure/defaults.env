# Published development defaults for the Compose stacks built from source
# (compose.yaml and compose.demo.yaml), so `docker compose up` works with nothing
# configured. Anyone can read these, and the API warns at every boot while they
# are in use.
#
# Do not edit this file to configure a stack. Put your own values in the
# repository-root .env, which every service that needs these lists after this
# file, so its values win. ENCRYPTION_KEY_PREVIOUS has no default: it is set only
# during a key rotation, in .env.
ENCRYPTION_KEY=replace-for-local-development-0000
ADMIN_TOKEN=replace-for-local-development-0000
