{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Resolve workspace packages to their TypeScript sources rather than to dist.
    // Without this, type checking apps/api requires packages/config and
    // packages/database to have been built first, so a clean clone fails until
    // something runs a build. Node ignores this condition at runtime and uses
    // the default export, which points at dist.
    "customConditions": ["development"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
