{
  // For this repository's check (tests/recipes-typecheck.test.ts): the SDK is
  // resolved to its source, and Express and BullMQ to the stubs. In your own
  // application, install the packages and drop `paths` and the stubs.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@wayscribe/node": ["../../../packages/sdk-node/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../stubs/express.d.ts", "../stubs/bullmq.d.ts"]
}
